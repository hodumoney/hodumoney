// app/api/subscribe/route.js
// 구독자 이메일을 Google Sheets subscribers 시트에 추가
import { google } from "googleapis";

export const dynamic = "force-dynamic";

// Google Sheets 인증 설정
// 환경변수: GOOGLE_SHEETS_ID, GOOGLE_SERVICE_ACCOUNT_EMAIL, GOOGLE_PRIVATE_KEY
function getSheets() {
  const auth = new google.auth.JWT(
    process.env.GOOGLE_SERVICE_ACCOUNT_EMAIL,
    null,
    (process.env.GOOGLE_PRIVATE_KEY || "").replace(/\\n/g, "\n"),
    ["https://www.googleapis.com/auth/spreadsheets"]
  );
  return google.sheets({ version: "v4", auth });
}

export async function POST(request) {
  try {
    const { email } = await request.json();

    if (!email || !email.includes("@") || !email.includes(".")) {
      return Response.json({ error: "올바른 이메일 주소를 입력해주세요." }, { status: 400 });
    }

    const normalizedEmail = email.trim().toLowerCase();
    const sheetId = process.env.GOOGLE_SHEETS_ID;

    if (!sheetId) {
      return Response.json({ error: "서버 설정 오류" }, { status: 500 });
    }

    const sheets = getSheets();

    // 기존 구독자 확인 (중복 방지)
    const existing = await sheets.spreadsheets.values.get({
      spreadsheetId: sheetId,
      range: "subscribers!A:A",
    });

    const existingEmails = (existing.data.values || [])
      .flat()
      .map(e => e.toString().trim().toLowerCase());

    if (existingEmails.includes(normalizedEmail)) {
      return Response.json({ error: "이미 구독 중인 이메일입니다." }, { status: 409 });
    }

    // 새 구독자 추가: [이메일, Y, 구독일, 채널]
    const today = new Date().toISOString().split("T")[0];
    await sheets.spreadsheets.values.append({
      spreadsheetId: sheetId,
      range: "subscribers!A:E",
      valueInputOption: "USER_ENTERED",
      requestBody: {
        values: [[normalizedEmail, "Y", today, "호두머니 사이트", ""]],
      },
    });

    return Response.json({ success: true, message: "구독 완료!" });
  } catch (err) {
    console.error("Subscribe error:", err);
    return Response.json({ error: "구독 처리 중 오류가 발생했습니다." }, { status: 500 });
  }
}
