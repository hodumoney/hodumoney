{
  "name": "hodumoney-valuescope-compat",
  "private": true,
  "scripts": {
    "predev": "npm --prefix ../hodumoney install",
    "dev": "npm --prefix ../hodumoney run dev",
    "prebuild": "npm --prefix ../hodumoney install",
    "build": "npm --prefix ../hodumoney run build && rm -rf .next && cp -R ../hodumoney/.next ./.next",
    "prestart": "npm --prefix ../hodumoney install",
    "start": "npm --prefix ../hodumoney run start"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
